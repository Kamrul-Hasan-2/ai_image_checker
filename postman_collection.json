          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": []
            },
            {
              "key": "category",
              "value": "electronics",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/clip/category",
          "host": ["{{base_url}}"],
          "path": ["clip", "category"]
        },
        "description": "Get CLIP similarity score for a specific category."
      },
      "response": []
    },
    {
      "name": "6. CLIP Risk Assessment",
      "request": {
        "method": "POST",
