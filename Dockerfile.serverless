# RunPod Serverless Dockerfile for AI Image Checker
FROM python:3.11-slim

WORKDIR /app

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    TRANSFORMERS_CACHE=/runpod-volume/huggingface \
    TORCH_HOME=/runpod-volume/torch \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install minimal system dependencies only (avoid libgl1 and mesa libraries)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    libgomp1 \
    libsm6 \
    libxext6 \
    libxrender1 \
    curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Copy requirements
COPY requirements_serverless.txt .

# Upgrade pip and increase timeout
RUN pip install --upgrade pip

# Install PyTorch CPU version with increased timeout and retries
RUN pip install --default-timeout=900 --retries=10 \
    torch torchvision --index-url https://download.pytorch.org/whl/cpu || \
    pip install --default-timeout=900 --retries=10 torch torchvision

# Install other dependencies
RUN pip install --default-timeout=300 -r requirements_serverless.txt

# Copy application code
COPY quality_service.py ocr_service.py clip_service.py qwen_service.py handler.py ./

# RunPod serverless handler entry point
CMD ["python", "-u", "-m", "runpod"]
