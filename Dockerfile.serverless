# RunPod Serverless Dockerfile for AI Image Checker
FROM python:3.11-slim

WORKDIR /app

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    TRANSFORMERS_CACHE=/runpod-volume/huggingface \
    TORCH_HOME=/runpod-volume/torch

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    libgomp1 \
    libgl1 \
    libsm6 \
    libxext6 \
    libxrender1 \
    curl && \
    rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements_serverless.txt .

# Install PyTorch CPU version first
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir -r requirements_serverless.txt

# Copy application code
COPY quality_service.py .
COPY ocr_service.py .
COPY clip_service.py .
COPY qwen_service.py .
COPY handler.py .

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    TRANSFORMERS_CACHE=/runpod-volume/huggingface \
    TORCH_HOME=/runpod-volume/torch

# RunPod will automatically call the handler
CMD ["python", "-u", "handler.py"]
